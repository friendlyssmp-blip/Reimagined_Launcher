# --------------------------- Reimagined Launcher .gitignore ---------------------------
# Never commit user data, credentials, caches or build output.

# Dependencies
node_modules/

# Build output
out/
# Everything in dist/ except the installer .exe (people download the setup
# directly from the repository). win-unpacked/ stays ignored.
dist/*
!dist/*.exe
release/

# ---- User data (profiles, accounts, tokens, logs, caches) — NEVER commit ----
# Everything under data/ is generated at runtime except the bundled assets.
data/*
!data/bundled/
!data/bundled/**

# Secrets / credentials / personal files
.env
.env.*
*.pem
*.key
*.p12
credentials.json
token.txt
!*.md

# Logs & temp
*.log
*.tmp
.tmp/
.cache/
temp/

# OS junk
Thumbs.db
.DS_Store
desktop.ini
$RECYCLE.BIN/

# Tooling / scratch (AI build-helper scripts — not part of the launcher)
.fpsboost-build/

# IDE
.vscode/
.idea/
*.swp
build/rcedit-x64.exe
